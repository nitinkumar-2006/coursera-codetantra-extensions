{
  "manifest_version": 3,
  "name": "Coursera Auto Helper",
  "version": "37.0",
  "description": "Apple Dark Glassmorphism + 35s Math-Quiz Timeout + Free-Tier 3.x Model Filter (No False 429) + Written/Numeric Typing + Verified Key (...3afw)",
  "permissions": ["activeTab", "tabs", "clipboardWrite"],
  "host_permissions": [
    "https://www.coursera.org/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.coursera.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
