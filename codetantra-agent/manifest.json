{
  "manifest_version": 3,
  "name": "CodeTantra AI Agent",
  "version": "10.10",
  "description": "CodeTantra AI Agent v10.0 Final: Zero-API-Key Gemini Web + API Key toggle, clean Settings drawer with 1s-60s Typing Speed Grid, surgical compiler/test-case diff fixes, and MCQ auto-solver",
  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://*.codetantra.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.codetantra.com/*"],
      "js": ["editor_bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.codetantra.com/*"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
