{
  "manifest_version": 3,
  "name": "CodeTantra AI Agent",
  "version": "16.6",
  "description": "CodeTantra AI Agent v16.4: Subject-wise persistent Gemini Web chats (Python/Java/WebTech), Anchor-based diff + inline gap injection",
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": [
    "https://*.codetantra.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.codetantra.com/*"],
      "js": ["editor_bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.codetantra.com/*"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
