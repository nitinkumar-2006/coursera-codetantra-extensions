{
  "manifest_version": 3,
  "name": "CodeTantra AI Agent",
  "version": "11.1",
  "description": "CodeTantra AI Agent v11.0: Python indentation & __init__ preservation, Gemini Web + ChatGPT fallback + API toggle, auto-Java/Lang selector, auto-Cancel popups, surgical compiler/test-case diff fixes",
  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://*.codetantra.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.codetantra.com/*"],
      "js": ["editor_bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.codetantra.com/*"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
